*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text

# Keep the character silhouette as a normal binary so GitHub Pages serves it
# (LFS-tracked files are served as broken pointer text on Pages).
character.png -filter -diff -merge -text

# Costume art is loaded directly by the web app, so keep it out of LFS too.
North_American_Birds/Costumes/*.png -filter -diff -merge -text
